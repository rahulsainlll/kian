# Copy to .env beside kian_tools.py. The shell's own variables win over this file.

# demo: synthetic data from fixtures.json (the default until token.json exists)
# google: the Google account you signed in with (run seed.py or any command once)
KIAN_BACKEND=demo

# The lead Sheet's id, from its URL: docs.google.com/spreadsheets/d/<id>/edit
# seed.py prints it after creating the sheet.
KIAN_SHEET_ID=

# Path to the desktop OAuth client from Google Cloud Console (defaults to ./credentials.json)
KIAN_GOOGLE_CREDENTIALS=

# The rep's first name, used in the brief's greeting
KIAN_REP_NAME=Yukti
